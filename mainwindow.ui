  <property name="styleSheet">
   <string>QMainWindow, QWidget#centralwidget { background: #f8fafc; }
QWidget { color: #0f172a; font-size: 10pt; }
QTabWidget::pane { border: 1px solid #e2e8f0; border-radius: 8px; background: #ffffff; top: -1px; }
QTabBar::tab { background: #f1f5f9; color: #64748b; padding: 8px 22px; border: 1px solid #e2e8f0; border-bottom: none; border-top-left-radius: 6px; border-top-right-radius: 6px; margin-right: 2px; font-weight: 600; }
QTabBar::tab:selected { background: #4f46e5; color: #ffffff; border-color: #4f46e5; }
QWidget#tabEncode, QWidget#tabDecode { background: #ffffff; }
QPushButton#dropZone { background: #f1f5f9; border: 2px dashed #cbd5e1; border-radius: 10px; color: #0f172a; font-weight: 600; padding: 12px; }
QPushButton#dropZone:hover { background: #eef2ff; border-color: #4f46e5; }
QFrame#encDetails, QFrame#decDetails { background: #f1f5f9; border-radius: 8px; }
QLabel[role="caption"] { color: #64748b; font-size: 8pt; }
QLabel[role="value"] { font-weight: 700; color: #0f172a; }
QStackedWidget#encPreview, QStackedWidget#decPreview { background: #000000; border-radius: 8px; }
QStackedWidget#encPreview QLabel, QStackedWidget#decPreview QLabel { color: #94a3b8; background: transparent; }
QLabel#lblDecHint { color: #64748b; }
QPlainTextEdit { background: #1e293b; color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; font-family: "DejaVu Sans Mono", monospace; font-size: 9pt; padding: 6px; }
QPushButton { background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 6px; padding: 8px 16px; font-weight: 600; }
QPushButton:hover { background: #e2e8f0; }
QPushButton:disabled { color: #94a3b8; }
QPushButton[primary="true"] { background: #4f46e5; color: #ffffff; border: none; }
QPushButton[primary="true"]:hover { background: #4338ca; }
QPushButton[primary="true"]:disabled { background: #a5b4fc; color: #eef2ff; }
QToolButton { background: #1e293b; color: #f8fafc; border: none; border-radius: 4px; padding: 4px 10px; }
QLabel#lblDecError { background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; border-radius: 6px; padding: 8px 12px; }
QComboBox, QLineEdit { border: 1px solid #e2e8f0; border-radius: 6px; padding: 5px 8px; background: #ffffff; }</string>
